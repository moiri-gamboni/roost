[Unit]
Description=Reopen the Claude Code sessions that were running before the reboot

[Service]
Type=oneshot
# A login shell, because the tmux server this starts inherits the environment
# and every later window would otherwise run without roost.sh's PATH and
# CLAUDE_CONFIG_DIR. Exit 1 is `session resume`'s "nothing queued", the normal
# outcome of any boot not preceded by `session reboot`, so it is not a failure.
# The resume runs in a scope of its own: at boot it is what starts the tmux
# server, and systemd kills a oneshot's leftover processes when it exits, which
# would take every reopened window with it. The scope keeps the environment.
ExecStart=/bin/bash -lc 'exec systemd-run --user --scope --quiet --collect "%h/bin/session" resume'
SuccessExitStatus=0 1

[Install]
WantedBy=default.target
