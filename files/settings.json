{
  "cleanupPeriodDays": 99999,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "3",
    "ENABLE_PROMPT_CACHING_1H": "1",
    "CLAUDE_CODE_SCROLL_SPEED": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  },
  "permissions": {
    "allow": [
      "Read",
      "WebSearch",
      "WebFetch",
      "mcp__exa__web_search_exa",
      "mcp__exa__web_fetch_exa",
      "mcp__notion__API-get-*",
      "mcp__notion__API-retrieve-*",
      "mcp__notion__API-list-data-source-templates",
      "mcp__notion__API-post-search",
      "mcp__notion__API-query-data-source"
    ],
    "ask": [
      "mcp__notion__API-patch-*",
      "mcp__notion__API-update-*",
      "mcp__notion__API-create-*",
      "mcp__notion__API-delete-*",
      "mcp__notion__API-post-page",
      "mcp__notion__API-move-page"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-fable-5-1[1m]",
  "fallbackModel": [
    "claude-opus-5"
  ],
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "xhigh"
    }
  },
  "hooks": {
    "SessionStart": [],
    "PreCompact": [],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/roost/apart-research/apart-tools/session/session --turn-end || true",
            "timeout": 2
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/roost/apart-research/apart-tools/session/session --turn-fail || true",
            "timeout": 2
          },
          {
            "type": "command",
            "command": "bash ~/roost/apart-research/apart-tools/session/session --rewake-waiter",
            "timeout": 700000,
            "asyncRewake": true,
            "rewakeMessage": "Claude usage limits (auto-resume waiter):",
            "rewakeSummary": "usage waiter: fresh window — auto-resuming"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/roost/apart-research/apart-tools/session/session --session-end || true",
            "timeout": 2
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/roost/claude/scripts/agent-worktree.sh finish",
            "timeout": 120
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/roost/apart-research/apart-tools/session/session --subagent-start || true",
            "timeout": 2
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/roost/apart-research/apart-tools/session/session --subagent-end || true",
            "timeout": 2
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/roost/apart-research/apart-tools/session/session --compact-mark || true",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/roost/claude/hooks/shellcheck-edit.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/roost/apart-research/apart-tools/session/session --hook || true",
            "timeout": 2
          },
          {
            "type": "command",
            "command": "bash ~/roost/apart-research/apart-tools/session/session --rewake-waiter",
            "asyncRewake": true,
            "timeout": 700000,
            "rewakeMessage": "Claude usage limits (auto-resume waiter):",
            "rewakeSummary": "usage waiter: fresh window — auto-resuming"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/roost/claude/hooks/notify.sh"
          },
          {
            "type": "command",
            "command": "bash ~/roost/apart-research/apart-tools/session/session --perm-mark || true",
            "timeout": 2
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/roost/claude/hooks/notion-write-guard.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/roost/claude/hooks/truncation-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/roost/claude/hooks/roughdraft-write-guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/roost/claude/scripts/agent-worktree.sh create",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "bash ~/roost/apart-research/apart-tools/session/statusline.sh",
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "playground@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": false,
    "praxis@praxis-marketplace": true,
    "serena@claude-plugins-official": true,
    "strip-images@claude-strip-images": true
  },
  "extraKnownMarketplaces": {
    "claude-strip-images": {
      "source": {
        "source": "github",
        "repo": "moiri-gamboni/claude-strip-images"
      }
    }
  },
  "effortLevel": "high",
  "askUserQuestionTimeout": "never",
  "tui": "fullscreen",
  "autoMemoryEnabled": true,
  "autoDreamEnabled": true,
  "skipWorkflowUsageWarning": true,
  "verbose": false,
  "autoCompactEnabled": true,
  "switchModelsOnFlag": false,
  "teammateMode": "in-process",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": false,
  "skipAutoPermissionPrompt": true,
  "autoContinueAtUsageLimit": true
}
