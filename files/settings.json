{
  "cleanupPeriodDays": 99999,
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DO_NOT_TRACK": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "DISABLE_BUG_COMMAND": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "3",
    "CLAUDE_CODE_DISABLE_EXPLORE_INHERIT_CAP": "1",
    "CLAUDE_CODE_SCROLL_SPEED": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "WORK_WORKSPACE": "/home/moiri/roost/work"
  },
  "permissions": {
    "allow": [
      "Read",
      "WebSearch",
      "WebFetch",
      "mcp__exa__web_search_exa",
      "mcp__exa__web_fetch_exa",
      "mcp__notion__API-get-*",
      "mcp__notion__API-retrieve-*",
      "mcp__notion__API-list-data-source-templates",
      "mcp__notion__API-post-search",
      "mcp__notion__API-query-data-source"
    ],
    "ask": [
      "mcp__notion__API-patch-*",
      "mcp__notion__API-update-*",
      "mcp__notion__API-create-*",
      "mcp__notion__API-delete-*",
      "mcp__notion__API-post-page",
      "mcp__notion__API-move-page"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-fable-5-1[1m]",
  "hooks": {
    "SessionStart": [],
    "PreCompact": [],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/moiri/roost/work/work-tools/session/session --turn-end || true",
            "timeout": 2
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/moiri/roost/work/work-tools/session/session --turn-fail || true",
            "timeout": 2
          },
          {
            "type": "command",
            "command": "bash /home/moiri/roost/work/work-tools/session/session --rewake-waiter",
            "timeout": 700000,
            "asyncRewake": true,
            "rewakeMessage": "Claude usage limits (auto-resume waiter):",
            "rewakeSummary": "usage waiter: fresh window \u2014 auto-resuming"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/moiri/roost/work/work-tools/session/session --session-end || true",
            "timeout": 2
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/roost/claude/scripts/agent-worktree.sh finish",
            "timeout": 120
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/moiri/roost/work/work-tools/session/session --subagent-start || true",
            "timeout": 2
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/moiri/roost/work/work-tools/session/session --subagent-end || true",
            "timeout": 2
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/moiri/roost/work/work-tools/session/session --compact-mark || true",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/roost/claude/hooks/shellcheck-edit.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/moiri/roost/work/work-tools/session/session --hook || true",
            "timeout": 2
          },
          {
            "type": "command",
            "command": "bash /home/moiri/roost/work/work-tools/session/session --rewake-waiter",
            "timeout": 700000,
            "asyncRewake": true,
            "rewakeMessage": "Claude usage limits (auto-resume waiter):",
            "rewakeSummary": "usage waiter: fresh window \u2014 auto-resuming"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/roost/claude/hooks/notify.sh"
          },
          {
            "type": "command",
            "command": "bash /home/moiri/roost/work/work-tools/session/session --perm-mark || true",
            "timeout": 2
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/roost/claude/hooks/notion-write-guard.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/roost/claude/hooks/truncation-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/roost/claude/hooks/roughdraft-write-guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "~/roost/claude/hooks/fork-context-guard.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/roost/claude/scripts/agent-worktree.sh create",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "enableArtifact": false,
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "bash /home/moiri/roost/work/work-tools/session/statusline.sh",
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "playground@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "praxis@praxis-marketplace": true,
    "serena@claude-plugins-official": true,
    "work-tools@work-tools": true,
    "diataxis@diataxis-skill": true
  },
  "extraKnownMarketplaces": {
    "work-tools": {
      "source": {
        "source": "git",
        "url": "git@github.com:example-org/work-tools.git"
      }
    },
    "diataxis-skill": {
      "source": {
        "source": "git",
        "url": "git@github.com:moiri-gamboni/diataxis-skill.git"
      }
    }
  },
  "feedbackDrafts": "off",
  "feedbackSurveyRate": 0,
  "promptCacheTtl": "1h",
  "subagentPromptCacheTtl": "1h",
  "effortLevel": "xhigh",
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "askUserQuestionTimeout": "never",
  "dialogExpiry": "never",
  "tui": "fullscreen",
  "autoMemoryEnabled": true,
  "autoDreamEnabled": true,
  "skipWorkflowUsageWarning": true,
  "verbose": false,
  "autoCompactEnabled": true,
  "switchModelsOnFlag": true,
  "autoContinueAtUsageLimit": true,
  "autoScrollEnabled": false,
  "autoUploadSessions": false,
  "teammateMode": "in-process",
  "remoteControlAtStartup": false,
  "crossSessionInbound": "accept",
  "agentPushNotifEnabled": false,
  "skipAutoPermissionPrompt": true
}
