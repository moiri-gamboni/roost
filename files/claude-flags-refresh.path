[Unit]
Description=Watch for Claude Code relinking ~/.local/bin/claude to a new version

[Path]
# The directory, not the link: a watch on the link follows it to the old binary,
# so an atomic rename of a new link over it fires nothing. Other changes here
# start the service too; the script exits on a version it has already handled.
PathChanged=$HOME_DIR/.local/bin

[Install]
WantedBy=paths.target
