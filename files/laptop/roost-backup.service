[Unit]
Description=Pull btrfs snapshots from roost server
After=network-online.target tailscaled.service
Wants=network-online.target
OnFailure=ntfy-roost-backup@%n.service

[Service]
Type=oneshot
User=${USERNAME}
ExecStart=/usr/local/bin/roost-backup
Environment=ROOST_SERVER=${SERVER_NAME}
Environment=ROOST_USER=${USERNAME}
