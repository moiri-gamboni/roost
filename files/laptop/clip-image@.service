[Unit]
Description=Answer one clip-image.socket request from the clipboard, images only

# ${CLIP_TOOL} is filled in by install-clip-image.sh: xclip or wl-paste, by
# desktop. The request comes in on the socket and the answer goes back on it;
# the script's log lines go to the journal.
[Service]
ExecStart=%h/.local/bin/clip-image-serve ${CLIP_TOOL}
StandardInput=socket
StandardOutput=socket
StandardError=journal
