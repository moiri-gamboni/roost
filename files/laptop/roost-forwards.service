[Unit]
Description=SSH connection carrying the laptop sockets the roost server uses (microphone, clipboard)
After=network-online.target

# The one connection that should request these forwards. Every connection that
# requests one rebinds the server path (sshd's StreamLocalBindUnlink) and leaves
# it dead when it closes, so forwards in the ~/.ssh/config Host block break with
# each short ssh or rsync. ${USERNAME} and ${SERVER_NAME} are filled in by
# install-roost-forwards.sh; 1000 is the server user's UID. ExitOnForwardFailure
# turns a refused forward into a restart, and the keepalives notice a connection
# lost to sleep or a network change.
[Service]
ExecStart=/usr/bin/ssh -N -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 \
    -R /run/user/1000/pulse-fwd:%t/pulse/native \
    -R /run/user/1000/clip-receive.sock:%t/clip-receive.sock \
    ${USERNAME}@${SERVER_NAME}
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
