# Environment
HOME=$HOME_DIR
ROOST_DIR_NAME=$ROOST_DIR_NAME
CLAUDE_CONFIG_DIR=$HOME_DIR/$ROOST_DIR_NAME/claude
BASH_ENV=$HOME_DIR/.bashrc.d/roost.sh

# Health check every 5 minutes
*/5 * * * * $USERNAME flock -n $HOME_DIR/.locks/health-check $HOME_DIR/$ROOST_DIR_NAME/claude/scheduled/health-check.sh

# Weekly memory cleanup — DISABLED. The ~/memory note system is not in use.
# To re-enable, uncomment the line below and roost-apply push.
#0 10 * * 0 $USERNAME flock -n $HOME_DIR/.locks/memory-cleanup $HOME_DIR/$ROOST_DIR_NAME/claude/scheduled/scheduled-task.sh "Review ~/$ROOST_DIR_NAME/memory/ for duplicate or mergeable notes. Deduplicate and merge where appropriate. Do not delete notes that passed the 6-month test at write time unless you can document a clear reason in the commit message." $HOME_DIR/$ROOST_DIR_NAME/code/life

# Attention ticker: moved to session-focus-tick.timer (10s). cron cannot go
# below a minute, and a minute is the resolution of every attended figure that
# comes out of it — a pause is measured up to a minute longer than it was,
# because a sample only ever reports the last keystroke of the minute it ran in.

# Daily brief of yesterday's Claude Code work (sessions, time, commits),
# summarized by Opus at medium effort from day-sliced session-CLI logs; ntfy'd
# as plain text and archived to ~/$ROOST_DIR_NAME/claude/usage/briefs/.
40 6 * * * $USERNAME flock -n $HOME_DIR/.locks/session-daily-brief $HOME_DIR/$ROOST_DIR_NAME/claude/scheduled/session-daily-brief.sh

# Daily Roughdraft upstream watch (7:10am): the global roughdraft is built from
# our fork because registry 0.1.10 is broken, so we need to notice when upstream
# moves — a merged PR means dropping a cherry-pick. Silent unless something
# changed. Daily is enough: upstream has merged nothing since 2026-06-19.
10 7 * * * $USERNAME flock -n $HOME_DIR/.locks/roughdraft-watch $HOME_DIR/$ROOST_DIR_NAME/claude/scheduled/roughdraft-watch.sh

# Weekly btrfs data balance (Sunday 2:30am): return slack trapped in
# part-empty data chunks to the unallocated pool so the metadata pool can keep
# growing. health-check.sh also runs it, under the same lock, whenever
# unallocated drops below 5GiB (RO-flip prevention).
30 2 * * 0 $USERNAME flock -n $HOME_DIR/.locks/btrfs-balance $HOME_DIR/$ROOST_DIR_NAME/claude/scheduled/btrfs-balance.sh

# Daily auto-update (2:50am): tools and OS packages whose latest release is at
# least 7 days old, ending in disk-cleanup.sh. Silent when nothing changed.
# 2:50, not 3:00: snapper's hourly snapshots fire on the hour and the whole run
# takes ~4 min, so the cleanup at its end lands BEFORE the 3:00 snapshot — the
# superseded toolchains and dangling Docker layers it removes never get pinned
# by a fresh snapshot. Started on the hour, they would sit in it for 24 h.
50 2 * * * $USERNAME flock -n $HOME_DIR/.locks/auto-update $HOME_DIR/$ROOST_DIR_NAME/claude/scheduled/auto-update.sh

# Weekly Travel-VPN audit (Sunday 4am): roost-net test when vpn=on. cmd_test ntfy_sends on failure so no extra wrapper is needed.
0 4 * * 0 $USERNAME flock -n $HOME_DIR/.locks/travel-audit sh -c 'if [ "$(cat /etc/roost-travel/vpn)" = "on" ]; then $HOME_DIR/$ROOST_DIR_NAME/claude/scripts/roost-net.sh test; fi'

# Daily Vision (Path D) abuse watch: ntfy on novel client IPs hitting the
# Vision inbound. Skips silently if /var/log/xray/access.log doesn't exist.
30 5 * * * $USERNAME flock -n $HOME_DIR/.locks/vision-abuse-watch $HOME_DIR/$ROOST_DIR_NAME/claude/scheduled/vision-abuse-watch.sh

# Session worktrees whose Claude died without a SessionEnd (a crash, a killed
# tmux pane): fast-forward what finished cleanly and drop it; anything dirty,
# diverged or whose root still exists is kept (3:35am).
35 3 * * * $USERNAME flock -n $HOME_DIR/.locks/agent-worktree-gc $HOME_DIR/bin/agent-worktree gc
