[Unit]
# The receiver refuses to start when the mirror state dir is absent (never
# creates it), so the mount ordering is load-bearing, not cosmetic.
RequiresMountsFor=/home/moiri/roost/apart-research/notion
Description=Notion webhook receiver (notion mirror event feed)
After=network.target

[Service]
User=moiri
# The receiver reads the Notion token from the Claude Code config dir on the
# first comment event; systemd starts it with no shell environment, so the
# roost config dir is named here.
Environment=CLAUDE_CONFIG_DIR=/home/moiri/roost/claude
ExecStart=/usr/bin/python3 /home/moiri/roost/code/notion-mirror/webhook_receiver.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
