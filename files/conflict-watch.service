[Unit]
Description=conflict-watch: which Claude Code session is writing in which folder or repo
Documentation=file://$HOME_DIR/$ROOST_DIR_NAME/claude/scripts/conflict-watch.py
After=local-fs.target

[Service]
# Root for fanotify (CAP_SYS_ADMIN) and the proc connector (CAP_NET_ADMIN). Notification events
# only: a dead or stuck daemon never blocks a write; the hook sees the daemon gone and goes quiet.
Environment=CLAUDE_CONFIG_DIR=$HOME_DIR/$ROOST_DIR_NAME/claude
ExecStart=/usr/bin/python3 $HOME_DIR/$ROOST_DIR_NAME/claude/scripts/conflict-watch.py run
Restart=always
RestartSec=2
# Holds live in /run/conflict-watch, which the daemon creates itself (root, the user's group,
# setgid 2770): kept across a restart (sessions outlive it), gone at reboot (the sessions are
# too). Not RuntimeDirectory=: systemd re-owns that directory's contents to root at every start,
# and the hook, running as the user, must keep appending to its per-session files. A stopped
# daemon takes its published holds with it, so the hook goes quiet.
ExecStopPost=/bin/rm -f /run/conflict-watch/holds.tsv
Nice=5
MemoryMax=256M
# Each watched write's fd is held for a moment until its file is named (renames settle); a burst
# such as a checkout needs many at once.
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
