[Unit]
Description=Notify ntfy on cert-renewal failure for %i
After=network.target

[Service]
Type=oneshot
# %i is the URL-decoded instance string (the failed unit's name, passed in via
# OnFailure=ntfy-cert-renew@%n.service in vision-cert-renew.service). It posts
# through ntfy_send, as the user, so the push carries the ntfy token and lands
# on the user's topic like every other alert (ntfy requires auth).
User=${USERNAME}
ExecStart=/bin/bash -c 'source ${HOME_DIR}/${ROOST_DIR_NAME}/claude/lib/_hook-env.sh && ntfy_send -t "Cert renewal FAILED" -p high "Unit %i failed; check journalctl -u %i for details."'
